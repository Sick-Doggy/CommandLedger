{
    "name": "arca-codicum/command-ledger",
    "description": "Run versioned Symfony console commands once, tracked in a Doctrine DBAL table.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^2.13 || ^3.0",
        "psr/log": "^1.1 || ^2 || ^3",
        "symfony/config": "^5.4",
        "symfony/console": "^5.4",
        "symfony/dependency-injection": "^5.4",
        "symfony/framework-bundle": "^5.4",
        "symfony/process": "^5.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.0",
        "symfony/yaml": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "ArcaCodicum\\CommandLedger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArcaCodicum\\CommandLedger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "cs": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true
    }
}
